local function makeLabel(parent,text,size,pos)
    local l = Instance.new("TextLabel")
    l.Size = size
    l.Position = pos
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(255,65,80)
    l.Font = Enum.Font.Code
    l.TextScaled = true
    l.Parent = parent
    return l
end

local function makeButton(text,pos,callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(48,38)
    b.Position = pos
    b.Text = text
    b.TextColor3 = Color3.new(1,1,1)
    b.BackgroundColor3 = Color3.fromRGB(125,12,32)
    b.Font = Enum.Font.Code
    b.TextScaled = true
    b.Parent = main
    Instance.new("UICorner",b).CornerRadius = UDim.new(0,7)
    b.Activated:Connect(callback)
    return b
end

